{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run server (nodemon)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/nodemon",
      "program": "${workspaceFolder}/server.js",
      "restart": true,
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Run server (plain node)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/server.js",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Create tables (db:setup)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/db-setup.js",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Seed database",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/seed.js",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Smoke test (no database)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/smoke-test.js",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    },
    {
      "name": "Test database layer (pg-mem)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/test-db.js",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ]
    }
  ]
}
