# ---- Copy this file to .env and fill in your own values ----
PORT=5000
NODE_ENV=development

# Supabase: Project Settings -> Database -> Connection string -> "Session pooler" (IPv4)
# Example:
#   postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/campus_lost_found

# Use a long random string in production (e.g. output of: openssl rand -hex 32)
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma separated list of allowed browser origins. Leave empty in development.
CLIENT_ORIGIN=

# true  -> new reports start as "pending" and need admin approval before they are public
# false -> new reports go live immediately as "active"
REQUIRE_MODERATION=false

# Seeded admin account (created by `npm run seed`)
# Demo admin created by `npm run seed`. CHANGE THIS BEFORE DEPLOYING, or set
# NODE_ENV=production and the seed script will refuse to use the default.
ADMIN_EMAIL=admin@saiuniversity.edu.in
ADMIN_PASSWORD=Admin@12345

# Apply db/schema.sql on boot (set to false if your host runs migrations itself)
AUTO_MIGRATE=true

# Optional: real email for the forgot-password flow. Leave blank and the app says so
# instead of pretending to send. Any SMTP provider works (Brevo, Resend, Gmail app password).
# Brevo (free: 300 emails/day) — SMTP & API -> SMTP tab
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=            # the login Brevo shows, usually something@smtp-brevo.com
SMTP_PASS=            # the SMTP key, NOT your account password
MAIL_FROM=            # must be a verified sender in Brevo
APP_URL=http://localhost:5000
