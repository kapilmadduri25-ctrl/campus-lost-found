{
  "info": {
    "name": "LOSTLY - API Tests (v1)",
    "description": "30 requests for the LOSTLY campus portal. Run folder 1 first (it captures token, otherToken and adminToken), then the rest in order. The image field points at postman/sample-image.png - if Postman asks you to re-select it, pick that file.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register new user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('returns a JWT token', () => pm.expect(pm.response.json().token).to.be.a('string'));",
                  "pm.test('role defaults to student', () => pm.expect(pm.response.json().user.role).to.eql('student'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Successful registration. Expected 201.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Student\",\n  \"email\": \"test{{$timestamp}}@saiuniversity.edu.in\",\n  \"password\": \"Password@123\",\n  \"department\": \"B.Tech CSE - Year 1\"\n}"
            }
          }
        },
        {
          "name": "Login (student) - saves token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('token present', () => pm.expect(json.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', json.token);",
                  "if (pm.environment.name) pm.environment.set('token', pm.collectionVariables.get('token'));",
                  "pm.collectionVariables.set('userId', json.user._id);",
                  "if (pm.environment.name) pm.environment.set('userId', pm.collectionVariables.get('userId'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Logs in the seeded student and stores the token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"arjun@saiuniversity.edu.in\",\n  \"password\": \"Password@123\"\n}"
            }
          }
        },
        {
          "name": "Login (second student) - saves otherToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('otherToken', json.token);",
                  "if (pm.environment.name) pm.environment.set('otherToken', pm.collectionVariables.get('otherToken'));",
                  "pm.test('otherToken captured', () => pm.expect(json.token).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Logs in the seeded student and stores the token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"meera@saiuniversity.edu.in\",\n  \"password\": \"Password@123\"\n}"
            }
          }
        },
        {
          "name": "Login (admin) - saves adminToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', json.token);",
                  "if (pm.environment.name) pm.environment.set('adminToken', pm.collectionVariables.get('adminToken'));",
                  "pm.test('adminToken captured', () => pm.expect(json.token).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Logs in the seeded student and stores the token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@saiuniversity.edu.in\",\n  \"password\": \"Admin@12345\"\n}"
            }
          }
        },
        {
          "name": "Login with wrong password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('error object with code', () => pm.expect(pm.response.json().error.code).to.eql('UNAUTHENTICATED'));",
                  "pm.test('no token leaked', () => pm.expect(pm.response.json().token).to.be.undefined);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Invalid credentials. Expected 401.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"arjun@saiuniversity.edu.in\",\n  \"password\": \"WrongPassword1\"\n}"
            }
          }
        },
        {
          "name": "Get my profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('email matches logged-in user', () => pm.expect(pm.response.json().user.email).to.include('arjun'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "description": "Protected route with a valid token. Expected 200."
          }
        }
      ]
    },
    {
      "name": "2. Items",
      "item": [
        {
          "name": "List items (public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('returns an array of items', () => pm.expect(json.items).to.be.an('array'));",
                  "pm.test('pagination metadata present', () => { pm.expect(json.total).to.be.a('number'); pm.expect(json.pages).to.be.a('number'); });",
                  "pm.test('no private fields leak', () => pm.expect(JSON.stringify(json.items)).to.not.include('descriptionPrivate'));",
                  "pm.test('reporter email not exposed', () => pm.expect(JSON.stringify(json.items)).to.not.include('@saiuniversity'));",
                  "if (json.items.length) pm.collectionVariables.set('itemId', json.items[0]._id);",
                  "if (pm.environment.name) pm.environment.set('itemId', pm.collectionVariables.get('itemId'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/items?limit=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "items"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            },
            "description": "Public listing with pagination and privacy checks. Expected 200."
          }
        },
        {
          "name": "Search and filter items",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('every result matches the filters', () => json.items.every(i => i.type === 'found' && i.category === 'Electronics'));",
                  "pm.test('only public statuses returned', () => json.items.every(i => ['active','claim_requested'].includes(i.status)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/items?search=laptop&category=Electronics&type=found&sort=date_desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "items"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "laptop"
                },
                {
                  "key": "category",
                  "value": "Electronics"
                },
                {
                  "key": "type",
                  "value": "found"
                },
                {
                  "key": "sort",
                  "value": "date_desc"
                }
              ]
            },
            "description": "Keyword search + category + type + sort. Expected 200."
          }
        },
        {
          "name": "Get one item by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('item has title and reference', () => { const i = pm.response.json().item; pm.expect(i.title).to.be.a('string'); pm.expect(i.reference).to.be.a('string'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/items/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "items",
                "{{itemId}}"
              ]
            },
            "description": "Item retrieval. Expected 200."
          }
        },
        {
          "name": "Create item (authorised)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('reference returned (LF-YY-XXXXXX)', () => pm.expect(json.reference).to.match(/^LF-\\d{2}-[A-Z0-9]{6}$/));",
                  "pm.test('status is active by default', () => pm.expect(json.item.status).to.eql('active'));",
                  "pm.test('possibleMatches array returned', () => pm.expect(json.possibleMatches).to.be.an('array'));",
                  "pm.test('private details not echoed back', () => pm.expect(json.item.descriptionPrivate).to.be.undefined);",
                  "pm.test('uploaded image is linked', () => pm.expect(json.item.imageUrl).to.match(/\\/uploads\\//));",
                  "pm.collectionVariables.set('newItemId', json.item._id);",
                  "if (pm.environment.name) pm.environment.set('newItemId', pm.collectionVariables.get('newItemId'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "items"
              ]
            },
            "description": "Authenticated create (multipart). Expected 201 with a reference.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Test Silver Wristwatch",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Found a silver wristwatch near the library entrance desk, strap has a small scratch.",
                  "type": "text"
                },
                {
                  "key": "descriptionPrivate",
                  "value": "Engraving on the back reads 12-04-2024.",
                  "type": "text"
                },
                {
                  "key": "category",
                  "value": "Accessories",
                  "type": "text"
                },
                {
                  "key": "type",
                  "value": "found",
                  "type": "text"
                },
                {
                  "key": "location",
                  "value": "Main Library",
                  "type": "text"
                },
                {
                  "key": "dateLostOrFound",
                  "value": "2026-11-14",
                  "type": "text"
                },
                {
                  "key": "contactInfo",
                  "value": "Ask at the library counter",
                  "type": "text"
                },
                {
                  "key": "image",
                  "value": "",
                  "type": "file",
                  "src": "postman/sample-image.png"
                }
              ]
            }
          }
        },
        {
          "name": "Create item - invalid input",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('validation details listed', () => pm.expect(pm.response.json().error.details).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "items"
              ]
            },
            "description": "Invalid category, type, date and short fields. Expected 400.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"ab\",\n  \"description\": \"short\",\n  \"category\": \"Spaceship\",\n  \"type\": \"borrowed\",\n  \"location\": \"Mars\",\n  \"dateLostOrFound\": \"2099-01-01\"\n}"
            }
          }
        },
        {
          "name": "Create item - no token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "items"
              ]
            },
            "description": "Unauthorised access attempt. Expected 401.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"No auth item\",\n  \"description\": \"This request has no bearer token at all.\",\n  \"category\": \"Other\",\n  \"type\": \"lost\",\n  \"location\": \"Cafeteria\",\n  \"dateLostOrFound\": \"2026-11-01\"\n}"
            }
          }
        },
        {
          "name": "Update my item",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('description updated', () => pm.expect(pm.response.json().item.description).to.include('Updated description'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/items/{{newItemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "items",
                "{{newItemId}}"
              ]
            },
            "description": "Owner updates their listing. Expected 200.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated description: silver wristwatch with a scratched strap, found at the library entrance.\"\n}"
            }
          }
        },
        {
          "name": "Update item - not the owner",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('403 forbidden - not the owner', () => pm.response.to.have.status(403));",
                  "pm.test('error code is FORBIDDEN', () => pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{otherToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/items/{{itemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "items",
                "{{itemId}}"
              ]
            },
            "description": "Authorisation check on update. Expected 403.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Trying to edit somebody else's listing should fail.\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "3. Claims",
      "item": [
        {
          "name": "Submit a claim with private proof",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('claimId', json.claim._id);",
                  "if (pm.environment.name) pm.environment.set('claimId', pm.collectionVariables.get('claimId'));",
                  "pm.test('claim starts pending', () => pm.expect(json.claim.status).to.eql('pending'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{otherToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/claims",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "claims"
              ]
            },
            "description": "Claim submission with private proof. Expected 201 (or 409 if already claimed).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itemId\": \"{{newItemId}}\",\n  \"message\": \"This is mine - the serial number ends 8821 and I have the invoice.\",\n  \"proof\": \"Invoice dated 12 March 2024, purchase price Rs 64,000.\"\n}"
            }
          }
        },
        {
          "name": "Submit the same claim again (should conflict)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 conflict', () => pm.response.to.have.status(409));",
                  "pm.test('error code is CONFLICT', () => pm.expect(pm.response.json().error.code).to.eql('CONFLICT'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{otherToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/claims",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
