        },
        {
          "name": "Claims on my listings",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('claims array returned', () => pm.expect(pm.response.json().claims).to.be.an('array'));"
                ]
